generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Room {
  id                String    @id @default(uuid()) @db.Char(36)
  name              String    @db.VarChar(45)
  normalized_name   String    @unique @db.VarChar(60) @default("")
  short_description String    @db.VarChar(45)
  full_description  String    @db.VarChar(300)
  server_banner     String    @db.VarChar(200)
  server_icon       String    @db.VarChar(200)
  created_at        DateTime? @default(now()) @db.DateTime(0)
  verified          Boolean   @default(false)
  status            RoomStatus @default(IN_REVISION)
  deletedAt         DateTime?

  ownerId   String?    @db.Char(36)
  owner     User?      @relation("OwnedRooms", fields: [ownerId], references: [id], onDelete: Cascade)
  
  favoritedBy FavoriteRoom[]
  userActivities UserRoomActivity[]
}

enum RoomStatus {
  IN_REVISION
  ACCEPTED
  REJECTED
}

model FavoriteRoom {
  userId    String
  roomId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("favorite_room")
}

model UserRoomActivity {
  userId             String    @db.Char(36)
  roomId             String    @db.Char(36)
  lastInteraction   DateTime  @default(now()) @db.DateTime(0)
  interactionCount   Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("user_room_activity")
}

model User {
  id                 String             @id
  name               String             @db.Text
  email              String
  emailVerified      Boolean
  image              String?            @db.Text
  username           String?            @unique
  bio                String?            @db.VarChar(255)
  location           String?            
  ageRange           AgeRange?          
  conversationType   ConversationType?  
  createdAt          DateTime
  updatedAt          DateTime
  sessions           Session[]
  accounts           Account[]
  hobbies            Hobby[]            
  ownedRooms         Room[]             @relation("OwnedRooms")
  
  // Relation to rooms favorited by the user
  favoriteRooms      FavoriteRoom[]
  roomActivities     UserRoomActivity[]

  @@unique([email])
  @@map("user")
}

model Hobby {
  id    String @id @default(cuid())
  name  String @unique 
  users User[]   
  icon  String? @db.VarChar(200)
}

enum AgeRange {
  RANGE_19_24 
  RANGE_25_34 
  RANGE_35_44 
  RANGE_45_PLUS 
}

enum ConversationType {
  CASUAL
  DEEP
  LEARNING
  SHARING_EXPERIENCES
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
